{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "characters.schema.json",
  "title": "ChappyNovelEngine character book data",
  "type": "object",
  "required": ["initial"],
  "properties": {
    "initial": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ruby", "image", "text"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "ruby": { "type": "string", "minLength": 1 },
          "image": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "patternProperties": {
    "^CH\\d{2}$": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "additionalProperties": false
}
